[setup]
density_boundary = yes
kspace_TF       = no
dump_delta      = yes
boxlength       = {BOXLENGTH}
zstart          = {ZSTART}
levelmin        = {LEVELMIN}
levelmin_TF     = {LEVELMIN}
levelmax        = {LEVELMAX}
padding         = {PADDING}
overlap         = 4
ref_center      = 0.5, 0.5, 0.5
ref_extent      = {REF_EXTENT}, {REF_EXTENT}, {REF_EXTENT}
align_top       = yes
no_shift        = yes
convolution_margin = -1
baryons         = no
use_2LPT        = {USE_2LPT}
ZeroRadiation   = true
[cosmology]
Omega_m         = 0.276
Omega_L         = 0.724
Omega_b         = 0.045
H0              = 70.3
sigma_8         = 0.811
n_s             = 0.961
transfer        = eisenstein
[random]
generator       = MUSIC
kaveraging      = no
seed[{LEVELMIN}]         = {SEED_COARSE}
seed[{LEVELMAX}]         = {SEED_FINE}
[output]
format          = {FORMAT}
filename        = {FILENAME}
[poisson]
fft_fine        = yes
accuracy        = {ACCURACY}
pre_smooth      = {SMOOTH}
post_smooth     = {SMOOTH}
smoother        = gs
laplace_order   = 6
grad_order      = 6
