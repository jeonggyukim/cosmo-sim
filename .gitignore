# MUSIC2 runtime logs
*.conf_log.txt

# Generated by MUSIC2 CLASS plugin (derived from conf; not hand-edited)
input_class_parameters.ini
conf/input_class_parameters_*.ini

# Generated MUSIC2 configs (reproducible via make_music_conf.py)
conf/CV_22_MUSIC_n*.conf

# MUSIC2 build output
music_build/

# Large binary data files (not versioned)
data/*.hdf5
data/*.bin

# Generated data outputs (reproducible via run_pipeline.sh)
data/pk_*.txt
data/xi_*.txt
data/rbins*.txt
data/class_pk_z*.dat

# Compiled C binaries
compute_xi
compute_xi_cic

# Claude Code auto-memory (machine-local)
memory/
.claude/

# Figures (generated; only notes/*.pdf used by LaTeX are versioned)
plots/
notes/*.png
notes/*.pdf
!notes/box_window.pdf
!notes/tophat_window.pdf
!notes/pgrid_comparison.pdf

# LaTeX auxiliary files (never version these)
*.aux
*.log
*.bbl
*.blg
*.out
*.toc
*.fls
*.synctex.gz

# Python
__pycache__/
*.pyc
