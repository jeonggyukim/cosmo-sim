# MUSIC2 runtime logs
*.conf_log.txt

# Generated by MUSIC2 CLASS plugin (derived from conf; not hand-edited)
input_class_parameters.ini
conf/input_class_parameters_*.ini

# Generated MUSIC2 configs (reproducible via make_music_conf.py)
conf/CV_22_MUSIC_n*.conf

# MUSIC2 build output
music_build/

# All pipeline data outputs (HDF5, binaries, P(k), xi, CLASS outputs)
data/

# Compiled C binaries
compute_xi
compute_xi_cic

# Claude Code auto-memory (machine-local)
memory/
.claude/

# Figures (generated; only the three box/tophat/pgrid PDFs copied to notes/ root are versioned)
plots/
# Prevent accidental root-level figure drops (use plots/ instead)
/*.png
/*.pdf
notes/*.png
notes/*.pdf
!notes/box_window.pdf
!notes/tophat_window.pdf
!notes/pgrid_comparison.pdf
notes/figures/*.pdf
notes/figures/*.png

# LaTeX auxiliary files (never version these)
*.aux
*.log
*.bbl
*.blg
*.out
*.toc
*.fls
*.synctex.gz

# Python
__pycache__/
*.pyc
.pytest_cache/

# Jupyter scratch notebooks (regenerable, never versioned)
notebooks/scratch-pad.ipynb
notebooks/.ipynb_checkpoints/

# Exploratory script outputs (regenerable)
scripts/restriction_*.png

# Python package build artifacts
*.egg-info/
build/
dist/
